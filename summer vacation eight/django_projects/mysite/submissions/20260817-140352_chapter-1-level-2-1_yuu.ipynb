        "def basic(height,weight):\n",
        "    bmi = weight / height*height\n",
        "    if bmi < 18.5:\n",
        "        return \"過輕\"\n",
        "    elif bmi >= 18.5 and bmi <=24:\n",
        "        return \"正常\"\n",
        "    elif bmi > 24:\n",
        "        return \"過重\""
      ]
    }
  ]
