      "source": [
        "# 範例：使用暫存變數交換（傳統寫法，供參考）\n",
        "def swap_values(a,b):\n",
        "    temp = a\n",
        "    a = b\n",
        "    b = temp\n",
        "    return (a,b)\n",
        "\n",
        "print(swap_values(10, 20))  # (20, 10)"
      ]
    }
  ]
}